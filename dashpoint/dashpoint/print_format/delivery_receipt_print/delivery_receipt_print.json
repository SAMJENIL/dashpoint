 "font_size": 14,
 "html": "<style>\r\n    @page {\r\n        size: A4;\r\n        margin: 1cm;\r\n    }\r\n\r\n    .print-summary {\r\n        text-align: center;\r\n        margin-bottom: 20px;\r\n    }\r\n\r\n    .section-title {\r\n        font-weight: bold;\r\n        text-align: center;\r\n        padding: 8px;\r\n    }\r\n\r\n    .packaging-table {\r\n        width: 100%;\r\n        border-collapse: collapse;\r\n    }\r\n\r\n    .packaging-table th,\r\n    .packaging-table td {\r\n        border: 1px solid #000;\r\n        padding: 6px;\r\n    }\r\n\r\n    .final-amount {\r\n        font-size: 20px;\r\n        font-weight: bold;\r\n    }\r\n\r\n    .page-break {\r\n        page-break-before: always;\r\n    }\r\n\r\n    @media print {\r\n        .no-print {\r\n            display: none !important;\r\n        }\r\n    }\r\n</style>\r\n\r\n{{ letter_head }}\r\n\r\n<h1 class=\"print-summary\">\r\n    {{ get_dispatch_center_name() }}\r\n</h1>\r\n\r\n<p class=\"print-summary\">\r\n    {{ doc.print_summary }}\r\n</p>\r\n\r\n<table class=\"table\">\r\n    <tr>\r\n        <td colspan=\"2\" class=\"section-title\">\r\n            Customer Details\r\n        </td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Customer Name</td>\r\n        <td>{{ doc.customer_name }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Customer Phone</td>\r\n        <td>{{ doc.customer_phone }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Customer Email</td>\r\n        <td>{{ doc.customer_email }}</td>\r\n    </tr>\r\n\r\n    <tr>\r\n        <td>Customer Address</td>\r\n        <td>{{ doc.pickup_address }}</td>\r\n    </tr>\r\n</table>\r\n\r\n<br>\r\n\r\n<h3>Packaging Details</h3>\r\n\r\n<table class=\"packaging-table {% if doc.packaging_used|length > 10 %}page-break{% endif %}\">\r\n    <thead>\r\n        <tr>\r\n            <th>Material Name</th>\r\n            <th>Unit Price</th>\r\n            <th>Quantity</th>\r\n            <th>Total Price</th>\r\n        </tr>\r\n    </thead>\r\n\r\n    <tbody>\r\n        {% for row in doc.packaging_used %}\r\n        <tr>\r\n            <td>{{ row.material_name }}</td>\r\n            <td>{{ row.unit_price }}</td>\r\n            <td>{{ row.quantity }}</td>\r\n            <td>{{ row.total_price }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>\r\n\r\n{% if doc.payment_status == \"COD Pending\" %}\r\n<div style=\"text-align:center; font-weight:bold; margin-top:20px;\">\r\n    COD \u2014 COLLECT \u20b9{{ doc.final_amount }} ON DELIVERY\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"final-amount\" style=\"text-align:right; margin-top:20px;\">\r\n    Final Amount:\r\n    {{ format_value(doc.final_amount, \"Currency\") }}\r\n</div>",
